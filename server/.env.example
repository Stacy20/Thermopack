# MongoDB
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/DATABASE

# Server (optional; defaults to 3000 if unset)
# PORT=3000

# AWS S3 (SDK v3 reads credentials from env by default)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=

# Optional: public URL base for stored objects (CloudFront or custom domain), no trailing slash
# S3_PUBLIC_BASE_URL=https://d1234567890.cloudfront.net

# Optional: prefix for object keys (e.g. uploads), no trailing slash
# S3_KEY_PREFIX=uploads
